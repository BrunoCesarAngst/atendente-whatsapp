{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "atendente-whatsapp",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"vars": {
		"WHATSAPP_PHONE_NUMBER_ID": "1419922544530447",
		"WHATSAPP_GRAPH_API_VERSION": "v25.0"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "atendenteg-production",
			"database_id": "cd6b91cc-5b3f-49e6-b24c-8316d7a2582a"
		}
	],
	"env": {
		"staging": {
			"observability": {
				"enabled": true,
				"logs": {
					"enabled": true,
					"invocation_logs": false
				}
			},
			"vars": {
				"WHATSAPP_PHONE_NUMBER_ID": "1329301080272794",
				"WHATSAPP_GRAPH_API_VERSION": "v25.0",
				"BUSINESS_PROFILE": "barbershop"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "atendenteg-staging",
					"database_id": "bc2cb547-da86-4973-97b3-a89f1258f9e8"
				}
			]
		}
	}
}
